{
  "name": "saathi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "demo:prepare": "node scripts/demo-prepare.mjs",
    "demo:accept": "node scripts/e2e-phase41-acceptance.mjs",
    "db:migrate": "tsx server/db/run-migrate.ts",
    "db:import:dry": "tsx server/db/import-store.ts --dry-run",
    "db:import": "tsx server/db/import-store.ts --apply",
    "db:verify": "tsx server/db/verify-import.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:pg:up": "docker run -d --rm --name sb-test-pg -e POSTGRES_PASSWORD=test -e POSTGRES_DB=shopbridge_test -p 127.0.0.1:55432:5432 --tmpfs /var/lib/postgresql:rw postgres:18",
    "test:pg:down": "docker rm -f sb-test-pg"
  },
  "dependencies": {
    "@nexconn/call": "^26.2.1",
    "@nexconn/chat": "^26.2.1",
    "@nexconn/engine": "^26.2.1",
    "bcrypt": "^6.0.0",
    "motion": "^14.9.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
