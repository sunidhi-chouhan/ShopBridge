# From Nexconn Console → Key Management. Use the same App Key in the demo and the submission form.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Singapore is the default data center.
NEXCONN_API_BASE=https://api.sg-light-api.com
PORT=8787

# PostgreSQL (Neon). Required for production / Render. When unset locally, JSON data/store.json is used.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# JSON data directory (local fallback only). Default: ./data
# SHOPBRIDGE_DATA_DIR=

# Demo sign-in password for local/hackathon use. Set locally; never commit a real .env.
SHOPBRIDGE_DEMO_PASSWORD=

# Allow POST /api/dev/reseed. Ignored when NODE_ENV=production.
# SHOPBRIDGE_ALLOW_RESEED=1

# Render / production: set NODE_ENV=production and DATABASE_URL (JSON fallback disabled).

# Shared demo: enables "Reset demo data" (account menu) for the demo accounts only.
# Set ONLY on the deployment designated as the public demo.
# SHOPBRIDGE_DEMO_RESET=1

# Apply additive SQL migrations automatically at boot (otherwise run `npm run db:migrate`).
# SHOPBRIDGE_AUTO_MIGRATE=1

# Optional AI reply drafts for support agents (Google AI Studio key, server-side only).
# GEMINI_API_KEY=
# GEMINI_MODEL=   # optional; default picks the newest available Gemini Flash model
